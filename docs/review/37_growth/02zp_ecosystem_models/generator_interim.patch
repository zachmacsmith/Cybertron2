+def _flood_low(g: Grid, h: np.ndarray, sea_level: float, flood_m: float) -> np.ndarray:
+    """Drown ground below sea_level + flood_m where it joins the sea or the window's edge; keep closed hollows inland as land."""
+    low = h < sea_level + flood_m
+    lab, n = F.components(low)
+    edge = np.zeros(g.shape, dtype=bool)
+    edge[0, :] = edge[-1, :] = edge[:, 0] = edge[:, -1] = True
+    seaward = set(np.unique(lab[edge & low]).tolist()) | set(np.unique(lab[h < sea_level]).tolist())
+    seaward.discard(0)
+    drown = np.isin(lab, list(seaward)) & low
+    out = h - flood_m
+    out = np.where(drown, np.minimum(out, sea_level - 1.0), np.maximum(out, sea_level + 0.5))
+    return out
+
+
