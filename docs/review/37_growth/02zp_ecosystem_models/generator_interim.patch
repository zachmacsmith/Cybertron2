diff --git a/tests/test_cybertron2_landgen.py b/tests/test_cybertron2_landgen.py
index a0836e2..968d3fd 100644
--- a/tests/test_cybertron2_landgen.py
+++ b/tests/test_cybertron2_landgen.py
@@ -264,3 +264,30 @@ def test_a_generated_world_has_no_gate_shut_for_everyone():
     for k, n in w["nodes"].items():
         if n.get("unexplored"):
             assert any(k in (a.get("places") or []) for a in w["agents"].values()), k
+
+
+def _land(**over):
+    conf = dict(V.DEFAULTS); conf.update(SMALL); conf.update(over); conf["seed"] = 5
+    g = F.grid(5, conf["size_km"], conf["km"])
+    return P.build(conf, g, M.primitives(conf))
+
+
+def test_a_higher_sea_drowns_low_ground_joined_to_it_and_keeps_inland_hollows():
+    """flood_m (02zp): the sea stands higher against the land; a drowned coast and islands, never an inland sea."""
+    dry, wet = _land(), _land(flood_m=70.0)
+    assert dry.sea.mean() == 0.0 and 0.1 < wet.sea.mean() < 0.95
+    from cybertron2.landgen.field import components
+    lab, n = components(wet.sea)
+    edge = np.zeros(wet.sea.shape, bool); edge[0, :] = edge[-1, :] = edge[:, 0] = edge[:, -1] = True
+    assert all(edge[lab == k].any() for k in range(1, n + 1))               # every sea reaches the window's edge
+
+
+def test_wetness_and_moisture_make_a_wetter_world_and_cold_makes_a_tree_line():
+    """wetness, moisture, treeline_c (02zp): absolute climate, not only the land's own ranking."""
+    from cybertron2.landgen import ecology as EC
+    base, wetter = _land(), _land(wetness=0.35, moisture=0.25)
+    assert wetter.wet.mean() > base.wet.mean() + 0.2 and wetter.moist.mean() > base.moist.mean() + 0.15
+    wet_ecos = ["fen", "reedbed", "alder carr", "wet grassland", "blanket bog"]
+    assert np.isin(wetter.eco, wet_ecos).mean() > np.isin(base.eco, wet_ecos).mean() + 0.05
+    cold = _land(temperature_c=3.0)
+    assert np.isin(cold.eco, EC.FORESTS).mean() < np.isin(base.eco, EC.FORESTS).mean() * 0.5
